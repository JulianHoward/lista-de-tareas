<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Aplicación de escritorio con interfaz gráfica (WinExe = sin consola detrás) -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>

    <!-- Datos de la aplicación (aparecen en el instalador y en Propiedades del .exe) -->
    <AssemblyName>TodoApp</AssemblyName>
    <Product>Lista de Tareas</Product>
    <Version>1.0.0</Version>
    <Company>Pasantías</Company>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/app-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Incluye los recursos (íconos, imágenes) dentro del ejecutable -->
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Framework de interfaz gráfica multiplataforma -->
    <PackageReference Include="Avalonia" Version="11.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.1.3" />
    <!-- Solo en modo Debug: muestra un panel para inspeccionar la interfaz -->
    <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Avalonia.Diagnostics" Version="11.1.3" />

    <!-- Ayudas para el patrón MVVM: clases base observables y comandos -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />

    <!-- Acceso a base de datos SQLite -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
  </ItemGroup>

</Project>
